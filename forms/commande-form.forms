{
  "components": [
    {
      "type": "textfield",
      "id": "nomClient",
      "key": "nomClient",
      "label": "Nom complet",
      "placeholder": "ex: Ahmed Ben Ali",
      "validate": {
        "required": true,
        "minLength": 2
      }
    },
    {
      "type": "textfield",
      "id": "emailClient",
      "key": "emailClient",
      "label": "Email",
      "placeholder": "ex: ahmed@email.com",
      "inputType": "email",
      "validate": {
        "required": true
      }
    },
    {
      "type": "textfield",
      "id": "telephoneClient",
      "key": "telephoneClient",
      "label": "Téléphone",
      "placeholder": "+216 XX XXX XXX"
    },
    {
      "type": "select",
      "id": "statutClient",
      "key": "statutClient",
      "label": "Statut client",
      "validate": {
        "required": true
      },
      "data": {
        "values": [
          {
            "label": "Nouveau client",
            "value": "NOUVEAU"
          },
          {
            "label": "Client régulier",
            "value": "REGULIER"
          },
          {
            "label": "Client VIP",
            "value": "VIP"
          },
          {
            "label": "Entreprise",
            "value": "ENTREPRISE"
          }
        ]
      }
    },
    {
      "type": "textfield",
      "id": "adresseLivraison",
      "key": "adresseLivraison",
      "label": "Adresse de livraison",
      "placeholder": "Numéro, rue, avenue...",
      "validate": {
        "required": true
      }
    },
    {
      "type": "textfield",
      "id": "ville",
      "key": "ville",
      "label": "Ville",
      "placeholder": "Tunis, Sfax...",
      "validate": {
        "required": true
      }
    },
    {
      "type": "textfield",
      "id": "codePostal",
      "key": "codePostal",
      "label": "Code postal",
      "placeholder": "1000"
    },
    {
      "type": "number",
      "id": "nbCommandesPrecedentes",
      "key": "nbCommandesPrecedentes",
      "label": "Nombre de commandes passées",
      "defaultValue": 0,
      "validate": {
        "min": 0
      }
    },
    {
      "type": "radio",
      "id": "stockDisponible",
      "key": "stockDisponible",
      "label": "Disponibilité stock",
      "defaultValue": "true",
      "data": {
        "values": [
          {
            "label": "✔ Disponible",
            "value": "true"
          },
          {
            "label": "✖ Rupture",
            "value": "false"
          }
        ]
      }
    },
    {
      "type": "textarea",
      "id": "notesCommande",
      "key": "notesCommande",
      "label": "Notes / instructions",
      "placeholder": "Instructions de livraison, demandes spéciales...",
      "rows": 3
    }
  ],
  "display": "form",
  "schemaVersion": 10,
  "exporter": {
    "name": "Camunda Modeler",
    "version": "5.46.1"
  }
}
